{
    "name": "daily-coder",
    "displayName": "Daily Coder Color Theme",
    "description": "A color theme that provides you a productive atmosphere during your daily challenges.",
    "version": "2.0.0",
    "publisher": "sirhennihau",
    "icon": "images/logo-scaled.png",
    "repository": {
        "url": "https://github.com/Sir-hennihau/daily-coder"
    },
    "scripts": {
        "package": "vsce package",
        "audit:colors": "node scripts/audit-colors.mjs",
        "build:vivid": "node scripts/build-vivid.mjs"
    },
    "engines": {
        "vscode": "^1.52.0"
    },
    "categories": [
        "Themes"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Daily Coder",
                "uiTheme": "vs-dark",
                "path": "./themes/Daily Coder-color-theme.json"
            },
            {
                "label": "Daily Coder Vivid",
                "uiTheme": "vs-dark",
                "path": "./themes/Daily Coder Vivid-color-theme.json"
            }
        ]
    },
    "dependencies": {},
    "devDependencies": {
        "@types/react": "^17.0.3",
        "react": "^17.0.2"
    }
}
