{
    "name": "Daily Coder Vivid",
    "type": "dark",

    "colors": {
        // Generated by `npm run build:vivid` from Daily Coder-color-theme.json. Do not edit by hand.
        // Only root colors are set. VS Code derives the rest from them (e.g. list.focusOutline
        // from focusBorder). Run `npm run audit:colors` to find uncovered roots.
        //
        // Every value comes from the palette in colors.ts. Shades carry the same contrast in every
        // family, so text is picked by shade for the surface it sits on:
        //   base #000000, embedded #222222 (title bar, peek, inputs), popups #323232 (hover,
        //   suggest, menus, quick input), #424242 list selection, #545454 focused row in popups.
        //   Hover, focus and the current line are translucent #f9f9f9 layers, so they lift any surface.
        // Borders stay flat: equal to the background or transparent.

