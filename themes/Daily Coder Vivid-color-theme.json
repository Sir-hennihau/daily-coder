    "tokenColors": [
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": {
                "foreground": "#eeeeee"
            }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "settings": {
                "foreground": "#f948ac"
            }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "foreground": "#909090",
                "fontStyle": "italic"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#9ad2fe"
            }
        },
        {
            "name": "String Template",
            "scope": "string.template",
            "settings": {
                "foreground": "#9ad2fe"
            }
        },
        {
            "name": "String Template",
            "scope": [
                "punctuation.definition.string.template.end",
                "punctuation.definition.string.template.begin"
            ],
            "settings": {
                "foreground": "#fe971f"
            }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#f948ac"
            }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": {
                "foreground": "#7d83fd"
            }
        },
