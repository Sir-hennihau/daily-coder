    "tokenColors": [
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": {
                "foreground": "#e9e9e9"
            }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "settings": {
                "foreground": "#ac5685"
            }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "foreground": "#666",
                "fontStyle": "italic"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#97bbd1"
            }
        },
        {
            "name": "String Template",
            "scope": "string.template",
            "settings": {
                "foreground": "#97bbd1"
            }
        },
        {
            "name": "String Template",
            "scope": [
                "punctuation.definition.string.template.end",
                "punctuation.definition.string.template.begin"
            ],
            "settings": {
                "foreground": "#dd6236"
            }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#9b3867"
            }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": {
                "foreground": "#666eb6"
            }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#e2e2e2"
            }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": {
                "fontStyle": "",
                "foreground": "#67a3c8"
            }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": {
                "foreground": "#e24d2f"
            }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": {
                "fontStyle": "",
                "foreground": "#4c87c1"
            }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#e2e2e2"
            }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type, entity.name.class",
            "settings": {
                "fontStyle": "underline",
                "foreground": "#e2e2e2"
            }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#e2e2e2"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": {
                "fontStyle": "",
                "foreground": "#efd72c"
            }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#d46345"
            }
        },
        {
            "name": "Tag name",
